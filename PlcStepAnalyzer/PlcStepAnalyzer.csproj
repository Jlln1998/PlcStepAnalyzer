<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>doodle-folder.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Fonts\AlimamaDongFangDaKai-Regular.ttf" />
    <None Remove="Resources\Fonts\AlimamaShuHeiTi-Bold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="doodle-folder.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mapster" Version="7.4.0" />
    <PackageReference Include="MiniExcel" Version="1.42.0" />
    <PackageReference Include="Prism.Unity" Version="9.0.537" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SqlSugarCoreNoDrive.Aot" Version="5.1.4.186" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlcStepAnalyzer.Model\PlcStepAnalyzer.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Fonts\AlimamaDongFangDaKai-Regular.ttf" />
