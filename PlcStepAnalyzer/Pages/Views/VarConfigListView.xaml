<UserControl x:Class="PlcStepAnalyzer.Pages.Views.VarConfigListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PlcStepAnalyzer.Pages.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PlcStepAnalyzer.Pages.ViewModels"
             d:DataContext="{d:DesignInstance vm:VarConfigListViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Background="Transparent"
             mc:Ignorable="d">
    <Border>
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="40">
                <StackPanel Background="Transparent" Focusable="True" Orientation="Horizontal">
                    <TextBox x:Name="NameInputBox"
                             Width="340"
                             Height="40"
                             FontSize="18"
                             Tag="请输入关键字搜索..."
                             Text="{Binding InputConfigName, Mode=OneWayToSource}"
                             Style="{DynamicResource TnputTipsTextBox}"/>
                    <Border Width="70"
                            Height="40"
                            VerticalAlignment="Center"
                            Margin="30,0,0,0"
                            Background="{DynamicResource SubjectColor}"
                            ClipToBounds="True"
                            CornerRadius="20">
                        <Button Command="{Binding QueryCmd}" CommandParameter="{Binding Text, ElementName=NameInputBox}" Style="{DynamicResource StaticIconBtnStyle}">
                            <TextBlock Text="搜 索"/>
                        </Button>
                    </Border>
                    <TextBlock VerticalAlignment="Center"
                               Margin="25,0,0,0"
                               FontSize="20"
                               Foreground="#2C3E50"
                               Text="{Binding Configs.Count, StringFormat=共找到 {0} 个参数表}"/>
                </StackPanel>
            </Border>
            <Border DockPanel.Dock="Top" Height="90">
                <StackPanel Orientation="Horizontal">
                    <Border Width="115"
                            Height="40"
                            Background="{DynamicResource SubjectColor}"
                            ClipToBounds="True"
                            CornerRadius="10">
                        <Button Command="{Binding AddCmd}" Style="{DynamicResource StaticIconBtnStyle}">新增配置表</Button>
                    </Border>
                </StackPanel>
            </Border>
            <Border>
                <DataGrid ItemsSource="{Binding Configs}" Style="{DynamicResource CustomDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="配置表"
                                            Width="2.8*"
                                            MinWidth="200"
                                            CellStyle="{DynamicResource DataGridFirstColumnCellStyle}"
                                            HeaderStyle="{DynamicResource DataGridFirstColumnHeaderStyle}"
                                            Binding="{Binding ConfigName}"/>
                        <DataGridTextColumn Header="配置数"
                                            Width="Auto"
                                            MinWidth="130"
                                            Binding="{Binding VarQty}"/>
                        <DataGridTextColumn Header="添加日期"
                                            Width="*"
                                            MinWidth="150"
                                            Binding="{Binding CreateTime, StringFormat=MM-dd HH:mm}"/>
                        <DataGridTextColumn Header="上次修改日期"
                                            Width="*"
                                            MinWidth="150"
                                            Binding="{Binding UpdateTime, StringFormat=MM-dd HH:mm}"/>
                        <DataGridTemplateColumn Header="操作" Width="*" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <ItemContainerTemplate>
                                    <Border Padding="10,0,10,0">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Border Width="65"
                                                    Height="35"
                                                    Background="{DynamicResource SubjectColor}"
                                                    ClipToBounds="True"
                                                    CornerRadius="18">
                                                <Button Command="{Binding DataContext.EditCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="编辑"
                                                        FontSize="14"
                                                        Style="{DynamicResource StaticIconBtnStyle}"/>
                                            </Border>
                                            <Border Width="65"
                                                    Height="35"
                                                    Margin="10,0,0,0"
                                                    Background="{DynamicResource SubjectColor}"
                                                    ClipToBounds="True"
                                                    CornerRadius="18">
                                                <Button Command="{Binding DataContext.DeleteCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="删除"
                                                        FontSize="14"
                                                        Style="{DynamicResource StaticIconBtnStyle}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </ItemContainerTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
