<UserControl x:Class="PlcStepAnalyzer.Pages.Views.GlobalConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PlcStepAnalyzer.Pages.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PlcStepAnalyzer.Pages.ViewModels"
             d:DataContext="{d:DesignInstance vm:GlobalConfigViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             FontSize="20"
             mc:Ignorable="d">
    <Border Padding="10,0,0,0">
        <StackPanel>
            <TextBlock HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="0,10,0,10"
                       FontSize="20"
                       Foreground="{DynamicResource FontColor_Title}"
                       Text="默认值设定"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="85"/>
                </Grid.RowDefinitions>
                <!--<TextBlock Grid.Column="0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource FontColor_Title}"
                           Text="起始行:"/>
                <TextBox Grid.Column="1"
                         Width="220"
                         Height="40"
                         VerticalAlignment="Center"
                         Margin="10,0,0,0"
                         FontSize="18"
                         Tag=""
                         Text="{Binding InputStartRow, Mode=TwoWay}"
                         Style="{DynamicResource TnputTipsTextBox}"/>
                <TextBlock Grid.Row="1" Grid.Column="0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource FontColor_Title}"
                           Text="起始列:"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Width="220"
                         Height="40"
                         VerticalAlignment="Center"
                         Margin="10,0,0,0"
                         FontSize="18"
                         Tag=""
                         Text="{Binding InputStartCol, Mode=TwoWay}"
                         Style="{DynamicResource TnputTipsTextBox}"/>-->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource FontColor_Title}"
                           Text="每行间隔(ms ):"/>
                <TextBox Grid.Row="0" Grid.Column="1"
                         Width="220"
                         Height="40"
                         VerticalAlignment="Center"
                         Margin="10,0,0,0"
                         FontSize="18"
                         Tag=""
                         Text="{Binding InputLineTime, Mode=TwoWay}"
                         Style="{DynamicResource TnputTipsTextBox}"/>
            </Grid>
            <Border Width="100"
                    Height="42"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="0,40,0,0"
                    Background="{DynamicResource BgColor_CtrlBtn}"
                    CornerRadius="10">
                <Button Command="{Binding SaveCmd}" Content="保存" Style="{DynamicResource StaticIconBtnStyle}"/>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
