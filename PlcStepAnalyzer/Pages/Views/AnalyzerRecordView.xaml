<UserControl x:Class="PlcStepAnalyzer.Pages.Views.AnalyzerRecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PlcStepAnalyzer.Pages.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:vm="clr-namespace:PlcStepAnalyzer.Pages.ViewModels"
             d:DataContext="{d:DesignInstance vm:AnalyzerRecordViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="900"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <Border>
        <DockPanel>
            <Border DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal">
                    <Border Width="115"
                            Height="40"
                            Background="{DynamicResource SubjectColor}"
                            ClipToBounds="True"
                            CornerRadius="10">
                        <Button Command="{Binding NewAnalyzerRecordCmd}" Style="{DynamicResource StaticIconBtnStyle}">新建解析</Button>
                    </Border>
                </StackPanel>
            </Border>
            <Border Margin="0,20,0,0">
                <DataGrid x:Name="dgData" ItemsSource="{Binding AnalyzerRecords}" Style="{DynamicResource CustomDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="文件"
                                                Width="4*"
                                                MinWidth="130"
                                                CellStyle="{DynamicResource DataGridFirstColumnCellStyle}"
                                                HeaderStyle="{DynamicResource DataGridFirstColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <ItemContainerTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FilePath}"/>
                                        <TextBlock Text="{Binding FileName}"/>
                                    </StackPanel>
                                </ItemContainerTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="文件类型" Width="1*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <ItemContainerTemplate>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center" Text="{Binding FileType}"/>
                                    </StackPanel>
                                </ItemContainerTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="采用的配置表" Width="2.5*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <ItemContainerTemplate>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center" Text="{Binding VarConfigName}"/>
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontSize="14"
                                                   Foreground="Red"
                                                   Text="(已被删除)"
                                                   Visibility="{Binding VarConfigIsDelete, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </ItemContainerTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="解析时间"
                                            Width="*"
                                            MinWidth="250"
                                            Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm:ss}"/>
                        <DataGridTemplateColumn Header="操作" Width="*" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <ItemContainerTemplate>
                                    <Border Padding="10,0,10,0">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Border Width="65"
                                                    Height="35"
                                                    Background="{DynamicResource SubjectColor}"
                                                    ClipToBounds="True"
                                                    CornerRadius="18">
                                                <Button Command="{Binding DataContext.WatchDetailCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="查看"
                                                        FontSize="14"
                                                        Style="{DynamicResource StaticIconBtnStyle}"/>
                                            </Border>
                                            <Border Width="65"
                                                    Height="35"
                                                    Margin="10,0,0,0"
                                                    Background="{DynamicResource SubjectColor}"
                                                    ClipToBounds="True"
                                                    CornerRadius="18">
                                                <Button Command="{Binding DataContext.DeleteCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="删除"
                                                        FontSize="14"
                                                        Style="{DynamicResource StaticIconBtnStyle}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </ItemContainerTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
