<UserControl x:Class="PlcStepAnalyzer.Pages.Views.DialogPage.AddVarConfigDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PlcStepAnalyzer.Pages.Views.DialogPage"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:vm="clr-namespace:PlcStepAnalyzer.Pages.ViewModels.DialogPage"
             Width="620"
             Height="375"
             d:DataContext="{d:DesignInstance vm:AddVarConfigDialogViewModel}"
             prism:Dialog.WindowStyle="{DynamicResource PrismDialogWindowStyle}"
             mc:Ignorable="d">
    <Border Background="White"
            BorderBrush="{DynamicResource SubjectColor}"
            BorderThickness="1.5"
            CornerRadius="15">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="25,25,0,0">
                <TextBlock Foreground="{DynamicResource FontColor_Title}" Text="新增配置表"/>
            </Border>
            <Border DockPanel.Dock="Bottom" Padding="20,0,0,45">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Width="120"
                            Height="50"
                            Background="{DynamicResource SecondaryColor}"
                            ClipToBounds="True"
                            CornerRadius="12">
                        <Button Command="{Binding CloseCmd}"
                                CommandParameter="Cancel"
                                Content="取消"
                                FontSize="20"
                                Style="{DynamicResource StaticIconBtnStyle}"/>
                    </Border>
                    <Border Width="120"
                            Height="50"
                            Margin="70,0,0,0"
                            Background="{DynamicResource SubjectColor}"
                            ClipToBounds="True"
                            CornerRadius="12">
                        <Button Command="{Binding CloseCmd}"
                                CommandParameter="Confirm"
                                Content="确认"
                                FontSize="20"
                                Style="{DynamicResource StaticIconBtnStyle}"/>
                    </Border>
                </StackPanel>
            </Border>
            <Border Padding="0,20,0,0">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Left" Margin="65,0,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource FontColor_Title}" Text="名  称："/>
                        <TextBox Width="380"
                                 Height="45"
                                 Margin="10,0,0,0"
                                 Tag="输入自定义配置表名..."
                                 Text="{Binding NewConfigName}"
                                 Style="{DynamicResource TnputTipsTextBox}"/>
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Center"
                               Margin="25,20,0,0"
                               Foreground="Red"
                               Text="{Binding ErrorMsg}"
                               Visibility="{Binding ErrorMsgVisibility}"/>
                </StackPanel>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
