<UserControl x:Class="PlcStepAnalyzer.Pages.Views.DialogPage.NewAnalyzerRecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PlcStepAnalyzer.Pages.Views.DialogPage"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:vm="clr-namespace:PlcStepAnalyzer.Pages.ViewModels.DialogPage"
             Width="600"
             Height="500"
             MaxHeight="1080"
             d:DataContext="{d:DesignInstance vm:NewAnalyzerRecordViewModel}"
             prism:Dialog.WindowStyle="{DynamicResource PrismDialogWindowStyle}"
             FontSize="16"
             mc:Ignorable="d">
    <Border Background="White"
            BorderBrush="{DynamicResource SubjectColor}"
            BorderThickness="1.5"
            CornerRadius="15">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="25,25,0,0">
                <TextBlock FontSize="20" Foreground="{DynamicResource FontColor_Title}" Text="解析文件"/>
            </Border>
            <Border DockPanel.Dock="Bottom" Padding="20,0,0,35">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Width="115"
                            Height="45"
                            Background="{DynamicResource SecondaryColor}"
                            ClipToBounds="True"
                            CornerRadius="12">
                        <Button Command="{Binding CloseCmd}"
                                CommandParameter="Cancel"
                                Content="取消"
                                FontSize="18"
                                Style="{DynamicResource StaticIconBtnStyle}"/>
                    </Border>
                    <Border Width="115"
                            Height="45"
                            Margin="70,0,0,0"
                            Background="{DynamicResource SubjectColor}"
                            ClipToBounds="True"
                            CornerRadius="12">
                        <Button Command="{Binding CloseCmd}"
                                CommandParameter="Confirm"
                                Content="确认"
                                FontSize="18"
                                Style="{DynamicResource StaticIconBtnStyle}"/>
                    </Border>
                </StackPanel>
            </Border>
            <Border Padding="0,20,0,0">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource FontColor_Title}"
                               Text="选择文件："/>
                    <Border Grid.Row="0" Grid.Column="1"
                            Grid.ColumnSpan="3"
                            Width="80"
                            Height="35"
                            HorizontalAlignment="Left"
                            Margin="12,0,0,0"
                            Background="#5DBCFF"
                            CornerRadius="7">
                        <Button Command="{Binding SelectFileCmd}" Foreground="{DynamicResource FontColor_Btn}" Style="{DynamicResource StaticIconBtnStyle}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                <Path Width="16"
                                      Height="16"
                                      Data="{DynamicResource FileSelectIcon}"
                                      Fill="{DynamicResource FontColor_Btn}"
                                      Stretch="Uniform"/>
                                <TextBlock Margin="7,0,0,0" FontSize="15" Text="选择"/>
                            </StackPanel>
                        </Button>
                    </Border>
                    <StackPanel Grid.Row="1" Grid.Column="1"
                                Grid.ColumnSpan="3"
                                VerticalAlignment="Center"
                                Margin="16,10,0,0"
                                Visibility="{Binding SelectedFileVisibility}">
                        <TextBlock HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   d:Text="F:\MyProject\DotNet\PLC 时序文件解析\"
                                   Foreground="{DynamicResource FontColor}"
                                   Text="{Binding SelectFilePath}"/>
                        <TextBlock HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="0,5,0,0"
                                   d:Text="1#机器时序20250210095908_00001.csv"
                                   Foreground="{DynamicResource FontColor}"
                                   Text="{Binding SelectFileName}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource FontColor_Title}"
                               Text="选择配置："/>
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              Grid.ColumnSpan="3"
                              Width="365"
                              Height="40"
                              HorizontalAlignment="Left"
                              Padding="0"
                              Margin="10,0,0,0"
                              Background="White"
                              DisplayMemberPath="Name"
                              FontSize="14"
                              IsReadOnly="True"
                              ItemsSource="{Binding VarConfigs}"
                              MaxDropDownHeight="200"
                              SelectedItem="{Binding SelectedVarConfig}"
                              Style="{DynamicResource ComboBoxStyle}"/>
                    <TextBlock Grid.Row="3" Grid.Column="0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource FontColor_Title}"
                               Text="起始行："/>
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Width="140"
                             Height="40"
                             HorizontalAlignment="Left"
                             Margin="10,0,0,0"
                             FontSize="18"
                             Tag=""
                             Text="{Binding InputRow}"
                             Style="{DynamicResource TnputTipsTextBox}"/>
                    <TextBlock Grid.Row="3" Grid.Column="2"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"
                               Foreground="{DynamicResource FontColor_Title}"
                               Text="起始列："/>
                    <TextBox Grid.Row="3" Grid.Column="3"
                             Width="140"
                             Height="40"
                             HorizontalAlignment="Left"
                             Margin="5,0,0,0"
                             FontSize="18"
                             Tag=""
                             Text="{Binding InputCol}"
                             Style="{DynamicResource TnputTipsTextBox}"/>
                    <TextBlock Grid.Row="4" Grid.Column="0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource FontColor_Title}"
                               Text="每行间隔："/>
                    <TextBox Grid.Row="4" Grid.Column="1"
                             Grid.ColumnSpan="3"
                             Width="140"
                             Height="40"
                             HorizontalAlignment="Left"
                             Margin="10,0,0,0"
                             FontSize="18"
                             Tag=""
                             Text="{Binding InputIndexTime}"
                             Style="{DynamicResource TnputTipsTextBox}"/>
                    <TextBlock Grid.Row="4" Grid.Column="2"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"
                               Foreground="{DynamicResource FontColor_Title}"
                               Text="(ms)"/>
                    <TextBlock Grid.Row="5" Grid.Column="1"
                               Grid.ColumnSpan="3"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Margin="25,0,0,0"
                               Foreground="Red"
                               Text="{Binding ErrorMsg}"
                               Visibility="{Binding ErrorMsgVisibility}"/>
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
