<UserControl x:Class="PlcStepAnalyzer.Pages.Views.DialogPage.ConfirmDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PlcStepAnalyzer.Pages.Views.DialogPage"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:vm="clr-namespace:PlcStepAnalyzer.Pages.ViewModels.DialogPage"
             Width="600"
             Height="380"
             d:DataContext="{d:DesignInstance vm:AddVarConfigDialogViewModel}"
             prism:Dialog.WindowStyle="{DynamicResource PrismDialogWindowStyle}"
             mc:Ignorable="d">
    <Border Background="White" CornerRadius="25">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="20">
                <TextBlock Text="新增配置表"/>
            </Border>
            <Border DockPanel.Dock="Bottom" Padding="0,0,0,50">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Width="115"
                            Height="45"
                            Background="{DynamicResource SecondaryColor}"
                            ClipToBounds="True"
                            CornerRadius="10">
                        <Button Command="{Binding CloseCmd}" CommandParameter="Cancel" Style="{DynamicResource StaticIconBtnStyle}">取消</Button>
                    </Border>

                    <Border Width="115"
                            Height="45"
                            Margin="70,0,0,0"
                            Background="{DynamicResource SubjectColor}"
                            ClipToBounds="True"
                            CornerRadius="10">
                        <Button Command="{Binding CloseCmd}" CommandParameter="Confirm" Style="{DynamicResource StaticIconBtnStyle}">确认</Button>
                    </Border>
                </StackPanel>
            </Border>
            <Border>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="名  称："/>
                        <TextBox Width="300"
                                 Height="50"
                                 Margin="15,0,0,0"
                                 Tag="输入自定义配置表名..."
                                 Text="{Binding NewParamsMapName}"
                                 Style="{DynamicResource TnputTipsTextBox}"/>
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Center"
                               Margin="0,20,0,0"
                               Foreground="Red"
                               Text="{Binding ErrorMsg}"
                               Visibility="{Binding ErrorMsgVisibility}"/>
                </StackPanel>

            </Border>
        </DockPanel>
    </Border>
</UserControl>
