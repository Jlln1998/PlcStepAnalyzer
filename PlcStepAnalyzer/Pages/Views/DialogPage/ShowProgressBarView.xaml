<Window x:Class="PlcStepAnalyzer.Pages.Views.DialogPage.ShowProgressBarView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:PlcStepAnalyzer.Pages.Views.DialogPage"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:vm="clr-namespace:PlcStepAnalyzer.Pages.ViewModels.DialogPage"
        Width="670"
        Height="400"
        d:DataContext="{d:DesignInstance vm:ShowProgressBarViewModel}"
        prism:Dialog.WindowStyle="{DynamicResource PrismDialogWindowStyle}"
        prism:ViewModelLocator.AutoWireViewModel="False"
        AllowsTransparency="True"
        Background="Transparent"
        Closed="Window_Closed"
        FontFamily="{DynamicResource AilimamaShuHei_Blod}"
        FontSize="22"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        mc:Ignorable="d">
    <Border Background="White"
            BorderBrush="{DynamicResource SubjectColor}"
            BorderThickness="1"
            CornerRadius="30">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressBar x:Name="ProgressBar"
                         Width="300"
                         Height="20"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Maximum="100"
                         Minimum="0"
                         Style="{DynamicResource ProgressBarStyle}"
                         Value="{Binding Value}"/>
            <TextBlock x:Name="MessageText"
                       HorizontalAlignment="Center"
                       Margin="0,25,0,0"
                       Foreground="Black"
                       Text="{Binding Text}"
                       TextAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
