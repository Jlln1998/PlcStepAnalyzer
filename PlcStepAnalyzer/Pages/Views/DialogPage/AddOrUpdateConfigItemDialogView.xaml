<UserControl x:Class="PlcStepAnalyzer.Pages.Views.DialogPage.AddOrUpdateConfigItemDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PlcStepAnalyzer.Pages.Views.DialogPage"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:vm="clr-namespace:PlcStepAnalyzer.Pages.ViewModels.DialogPage"
             Width="620"
             Height="500"
             MaxHeight="1080"
             d:DataContext="{d:DesignInstance vm:AddOrUpdateConfigItemDialogViewModel}"
             prism:Dialog.WindowStyle="{DynamicResource PrismDialogWindowStyle}"
             mc:Ignorable="d">
    <Border Background="White"
            BorderBrush="{DynamicResource SubjectColor}"
            BorderThickness="1.5"
            CornerRadius="15">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="25,25,0,0">
                <TextBlock Foreground="{DynamicResource FontColor_Title}" Text="{Binding Title}"/>
            </Border>
            <Border DockPanel.Dock="Bottom" Padding="20,0,0,45">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Width="120"
                            Height="50"
                            Background="{DynamicResource SecondaryColor}"
                            ClipToBounds="True"
                            CornerRadius="12">
                        <Button Command="{Binding CloseCmd}"
                                CommandParameter="Cancel"
                                Content="取消"
                                FontSize="20"
                                Style="{DynamicResource StaticIconBtnStyle}"/>
                    </Border>
                    <Border Width="120"
                            Height="50"
                            Margin="70,0,0,0"
                            Background="{DynamicResource SubjectColor}"
                            ClipToBounds="True"
                            CornerRadius="12">
                        <Button Command="{Binding CloseCmd}"
                                CommandParameter="Confirm"
                                Content="确认"
                                FontSize="20"
                                Style="{DynamicResource StaticIconBtnStyle}"/>
                    </Border>
                </StackPanel>
            </Border>
            <Border Padding="0,20,0,0">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Left" Margin="65,0,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource FontColor_Title}" Text="变量名："/>
                        <Grid>
                            <TextBlock VerticalAlignment="Center"
                                       Margin="20,0,0,0"
                                       d:Text=""
                                       Text="{Binding InputVarConfigItem.VarName}"
                                       Visibility="{Binding IsEdit, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBox Width="380"
                                     Height="45"
                                     VerticalAlignment="Center"
                                     Margin="10,0,0,0"
                                     Tag="输入变量名..."
                                     Text="{Binding InputVarConfigItem.VarName}"
                                     Visibility="{Binding IsEdit, Converter={StaticResource BoolToVisibility}, ConverterParameter=true}"
                                     Style="{DynamicResource TnputTipsTextBox}"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Left" Margin="65,15,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource FontColor_Title}" Text="变量值："/>
                        <TextBox Width="380"
                                 Height="45"
                                 Margin="10,0,0,0"
                                 Tag="输入变量值..."
                                 Text="{Binding InputVarConfigItem.VarValue}"
                                 Style="{DynamicResource TnputTipsTextBox}"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Left" Margin="65,15,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource FontColor_Title}" Text="工位名："/>
                        <TextBox Width="380"
                                 Height="45"
                                 Margin="10,0,0,0"
                                 Tag="输入工位名..."
                                 Text="{Binding InputVarConfigItem.StationName}"
                                 Style="{DynamicResource TnputTipsTextBox}"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Left" Margin="65,15,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource FontColor_Title}" Text="动作名："/>
                        <TextBox Width="380"
                                 Height="45"
                                 Margin="10,0,0,0"
                                 Tag="输入步骤名..."
                                 Text="{Binding InputVarConfigItem.ActionName}"
                                 Style="{DynamicResource TnputTipsTextBox}"/>
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Center"
                               Margin="25,20,0,0"
                               Foreground="Red"
                               Text="{Binding ErrorMsg}"
                               TextWrapping="Wrap"
                               Visibility="{Binding ErrorMsgVisibility}"/>
                </StackPanel>

            </Border>
        </DockPanel>
    </Border>
</UserControl>
