<UserControl x:Class="PlcStepAnalyzer.Pages.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PlcStepAnalyzer.Pages.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid Width="800"
          Height="500"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Margin="0,0,0,0">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-100,0,0">
            <TextBlock HorizontalAlignment="Center"
                       FontFamily="{DynamicResource AilimamaDongFangDaKai_Regular}"
                       FontSize="32"
                       Foreground="Black"
                       Text="简单软件，懒得写说明了..."/>
            <TextBlock HorizontalAlignment="Center"
                       Margin="0,45,0,0"
                       FontFamily="{DynamicResource AilimamaDongFangDaKai_Regular}"
                       FontSize="32"
                       Foreground="Black"
                       Text="有事联系：1727165838@qq.com"/>
            <TextBlock HorizontalAlignment="Center"
                       Margin="0,45,0,0"
                       FontFamily="{DynamicResource AilimamaDongFangDaKai_Regular}"
                       FontSize="32"
                       Foreground="Black"
                       Text="源码已放 Github，点左上角访问"/>
            <TextBlock HorizontalAlignment="Center"
                       Margin="0,45,0,0"
                       FontFamily="{DynamicResource AilimamaDongFangDaKai_Regular}"
                       FontSize="32"
                       Foreground="Black"
                       Text="可接桌面程序设计与开发"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       FontFamily="{DynamicResource AilimamaDongFangDaKai_Regular}"
                       FontSize="32"
                       Foreground="Black"
                       Text="极乐流年"/>
            <TextBlock HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       FontFamily="{DynamicResource AilimamaDongFangDaKai_Regular}"
                       FontSize="24"
                       Foreground="Black"
                       Text="2025.12.28"/>
        </StackPanel>
    </Grid>
</UserControl>
