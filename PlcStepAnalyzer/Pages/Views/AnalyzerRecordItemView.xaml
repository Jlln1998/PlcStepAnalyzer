<UserControl x:Class="PlcStepAnalyzer.Pages.Views.AnalyzerRecordItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PlcStepAnalyzer.Pages.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PlcStepAnalyzer.Pages.ViewModels"
             d:DataContext="{d:DesignInstance vm:AnalyzerRecordItemViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Background="Transparent"
             mc:Ignorable="d">
    <Border>
        <DockPanel>
            <Border DockPanel.Dock="Top" MinHeight="40">
                <WrapPanel Background="Transparent" Focusable="True">
                    <TextBox x:Name="NameInputBox"
                             Width="500"
                             Height="40"
                             VerticalAlignment="Center"
                             Margin="0,15,30,0"
                             FontSize="18"
                             Tag="输入变量名或者工位名筛选..."
                             Text="{Binding InputName, Mode=OneWayToSource}"
                             Style="{DynamicResource TnputTipsTextBox}"/>
                    <Border Width="70"
                            Height="40"
                            VerticalAlignment="Center"
                            Margin="0,15,30,0"
                            Background="{DynamicResource SubjectColor}"
                            ClipToBounds="True"
                            CornerRadius="20">
                        <Button Command="{Binding QueryCmd}" Style="{DynamicResource StaticIconBtnStyle}">
                            <TextBlock Text="搜 索"/>
                        </Button>
                    </Border>
                    <Border Width="140"
                            Height="40"
                            VerticalAlignment="Center"
                            Margin="0,15,30,0"
                            Background="{DynamicResource SubjectColor}"
                            ClipToBounds="True"
                            CornerRadius="10">
                        <Button Command="{Binding ExportCmd}" CommandParameter="Now" Style="{DynamicResource StaticIconBtnStyle}">
                            <TextBlock Text="导出当前数据"/>
                        </Button>
                    </Border>
                    <Border Width="140"
                            Height="40"
                            VerticalAlignment="Center"
                            Margin="0,15,30,0"
                            Background="{DynamicResource SubjectColor}"
                            ClipToBounds="True"
                            CornerRadius="10">
                        <Button Command="{Binding ExportCmd}" CommandParameter="All" Style="{DynamicResource StaticIconBtnStyle}">
                            <TextBlock Text="导出全部数据"/>
                        </Button>
                    </Border>
                </WrapPanel>
            </Border>
            <Border Margin="0,15,0,15">
                <DataGrid x:Name="dgData" ItemsSource="{Binding AnalyzerRecordItems}" Style="{DynamicResource CustomDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="工位"
                                                Width="3.5*"
                                                MinWidth="220"
                                                CellStyle="{DynamicResource DataGridFirstColumnCellStyle}"
                                                HeaderStyle="{DynamicResource DataGridFirstColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Left" Text="{Binding StationName}" ToolTip="{Binding VarName}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="流程步值"
                                            Width="2*"
                                            MinWidth="150"
                                            Binding="{Binding VarValue}"/>
                        <DataGridTemplateColumn Header="动作" Width="2*" MinWidth="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <ItemContainerTemplate>
                                    <TextBlock Tag="{Binding VarValue}" Text="{Binding ActionName}"/>
                                </ItemContainerTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="动作耗时(s)"
                                            Width="2*"
                                            MinWidth="150"
                                            Binding="{Binding ElapsedTime, StringFormat=F3}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
