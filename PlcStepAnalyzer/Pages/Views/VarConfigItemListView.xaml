<UserControl x:Class="PlcStepAnalyzer.Pages.Views.VarConfigItemListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PlcStepAnalyzer.Pages.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PlcStepAnalyzer.Pages.ViewModels"
             d:DataContext="{d:DesignInstance vm:VarConfigItemListViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             FontSize="16"
             Foreground="{DynamicResource FontColor}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="BtnBorder" TargetType="Border">
            <Setter Property="Width" Value="95"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="{DynamicResource SubjectColor}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </UserControl.Resources>
    <Border>
        <DockPanel>
            <Border DockPanel.Dock="Top">
                <StackPanel>
                    <StackPanel Background="Transparent" Focusable="True" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource FontColor_Title}" Text="配置表："/>
                        <TextBlock VerticalAlignment="Center"
                                   Margin="5,0,0,0"
                                   Foreground="{DynamicResource FontColor_Title}"
                                   Text="{Binding VarConfigVo.ConfigName}"/>
                        <Button Margin="10,0,0,0" Command="{Binding EditConfigNameCmd}" Style="{DynamicResource StaticIconBtnStyle}">
                            <Path Width="15"
                                  Height="15"
                                  Data="{DynamicResource EditIcon}"
                                  Fill="{DynamicResource FontColor_Title}"
                                  Stretch="UniformToFill"/>
                        </Button>
                    </StackPanel>
                    <WrapPanel>
                        <StackPanel Margin="0,20,30,0" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource FontColor_Title}" Text="变量名："/>
                            <TextBox Width="400"
                                     Height="40"
                                     Tag="输入变量名搜索..."
                                     Text="{Binding InputConfigItem.VarName, Mode=OneWayToSource}"
                                     Style="{DynamicResource TnputTipsTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="0,20,30,0" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource FontColor_Title}" Text="变量值："/>
                            <TextBox Width="200"
                                     Height="40"
                                     Tag="输入变量值搜索..."
                                     Text="{Binding InputConfigItem.VarValue, Mode=OneWayToSource}"
                                     Style="{DynamicResource TnputTipsTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="0,20,30,0" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource FontColor_Title}" Text="工位名："/>
                            <TextBox Width="200"
                                     Height="40"
                                     Tag="输入工位名搜索..."
                                     Text="{Binding InputConfigItem.StationName, Mode=OneWayToSource}"
                                     Style="{DynamicResource TnputTipsTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource FontColor_Title}" Text="步骤名："/>
                            <TextBox Width="200"
                                     Height="40"
                                     Tag="输入步骤名搜索..."
                                     Text="{Binding InputConfigItem.ActionName, Mode=OneWayToSource}"
                                     Style="{DynamicResource TnputTipsTextBox}"/>
                            <Border Width="70"
                                    Height="35"
                                    VerticalAlignment="Center"
                                    Margin="30,0,0,0"
                                    Background="{DynamicResource SubjectColor}"
                                    CornerRadius="18">
                                <Button Command="{Binding QueryCmd}" Style="{DynamicResource StaticIconBtnStyle}">
                                    <TextBlock FontSize="16" Text="搜 索"/>
                                </Button>
                            </Border>
                            <TextBlock VerticalAlignment="Center"
                                       Margin="25,0,0,0"
                                       FontSize="20"
                                       Foreground="#2C3E50"
                                       Text="{Binding QueriedConfigItems.Count, StringFormat=共找到 {0} 个参数表}"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>

            </Border>
            <Border DockPanel.Dock="Top" Height="80">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Border Style="{DynamicResource BtnBorder}">
                            <Button Command="{Binding AddOrUpdateCmd}" FontSize="16" Style="{DynamicResource StaticIconBtnStyle}">新增配置</Button>
                        </Border>
                        <Border Style="{DynamicResource BtnBorder}">
                            <Button Command="{Binding ImportDataCmd}" FontSize="16" Style="{DynamicResource StaticIconBtnStyle}">批量导入</Button>
                        </Border>
                        <Border Style="{DynamicResource BtnBorder}">
                            <Button Command="{Binding ClearAllCmd}" FontSize="16" Style="{DynamicResource StaticIconBtnStyle}">清空数据</Button>
                        </Border>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Border Style="{DynamicResource BtnBorder}">
                            <Button Command="{Binding ExportTemplateCmd}" FontSize="16" Style="{DynamicResource StaticIconBtnStyle}">导出模板</Button>
                        </Border>
                        <Border Width="120" Style="{DynamicResource BtnBorder}">
                            <Button Command="{Binding ExportDataCmd}" FontSize="16" Style="{DynamicResource StaticIconBtnStyle}">
                                导出当前数据
                            </Button>
                        </Border>
                    </StackPanel>
                </DockPanel>

            </Border>
            <Border>
                <DataGrid ItemsSource="{Binding QueriedConfigItems}" Style="{DynamicResource CustomDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="变量名称"
                                            Width="2.8*"
                                            MinWidth="200"
                                            CellStyle="{DynamicResource DataGridFirstColumnCellStyle}"
                                            HeaderStyle="{DynamicResource DataGridFirstColumnHeaderStyle}"
                                            Binding="{Binding VarName}"/>
                        <DataGridTextColumn Header="变量值"
                                            Width="Auto"
                                            MinWidth="130"
                                            Binding="{Binding VarValue}"/>
                        <DataGridTextColumn Header="工位名"
                                            Width="Auto"
                                            MinWidth="240"
                                            Binding="{Binding StationName}"/>
                        <DataGridTextColumn Header="步骤名"
                                            Width="Auto"
                                            MinWidth="240"
                                            Binding="{Binding ActionName}"/>
                        <DataGridTemplateColumn Header="操作" Width="*" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <ItemContainerTemplate>
                                    <Border Padding="10,0,10,0">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Border Width="65"
                                                    Height="35"
                                                    Background="{DynamicResource SubjectColor}"
                                                    ClipToBounds="True"
                                                    CornerRadius="18">
                                                <Button Command="{Binding DataContext.AddOrUpdateCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="编辑"
                                                        FontSize="14"
                                                        Style="{DynamicResource StaticIconBtnStyle}"/>
                                            </Border>
                                            <Border Width="65"
                                                    Height="35"
                                                    Margin="15,0,0,0"
                                                    Background="{DynamicResource SubjectColor}"
                                                    ClipToBounds="True"
                                                    CornerRadius="18">
                                                <Button Command="{Binding DataContext.DeleteCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="删除"
                                                        FontSize="14"
                                                        Style="{DynamicResource StaticIconBtnStyle}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </ItemContainerTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
