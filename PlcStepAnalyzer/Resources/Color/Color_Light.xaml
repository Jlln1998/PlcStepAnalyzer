<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  窗体背景色  -->
    <SolidColorBrush x:Key="BgColor_Window" Color="#FFFFFF"/>
    <!--  底部签名字体色  -->
    <SolidColorBrush x:Key="FontColor_Author" Opacity="0.8" Color="#5C5C5C"/>
    <!--  弹窗蒙版背景色  -->
    <SolidColorBrush x:Key="BgColor_DialogMask" Opacity="0.5" Color="#4D4B4B"/>

    <!--  主题色  -->
    <SolidColorBrush x:Key="SubjectColor" Color="#2A82E4"/>
    <!--  次级色  -->
    <SolidColorBrush x:Key="SecondaryColor" Color="#CECECE"/>

    <!--  菜单背景色  -->
    <SolidColorBrush x:Key="BgColor_Menu" Color="#273139"/>
    <!--  菜单背景色-选中  -->
    <SolidColorBrush x:Key="BgColor_MenuSelected" Color="#DF4C5B"/>
    <!--  菜单字体色  -->
    <SolidColorBrush x:Key="FontColor_Menu" Color="#FFFFFF"/>

    <!--  导航背景色-1级  -->
    <SolidColorBrush x:Key="BgColor_NavFirst" Color="#2A82E4"/>
    <!--  导航背景色-2级  -->
    <SolidColorBrush x:Key="BgColor_NavSecound" Color="#F4F4F4"/>
    <!--  导航字体色  -->
    <SolidColorBrush x:Key="FontColor_Nav" Color="#A6A6A6"/>
    <!--  导航字体色(选中)  -->
    <SolidColorBrush x:Key="FontColor_NavSelected" Color="#2A82E4"/>

    <!--  窗体三按钮背景色  -->
    <SolidColorBrush x:Key="BgColor_CtrlBtn" Color="#2A82E4"/>
    <!--  窗体三按钮字体色  -->
    <SolidColorBrush x:Key="FontColor_CtrlBtn" Color="#2A82E4"/>

    <!--  全局字体色  -->
    <SolidColorBrush x:Key="FontColor" Color="#A6A6A6"/>
    <!--  全局字体色-标题  -->
    <SolidColorBrush x:Key="FontColor_Title" Color="#2C3E50"/>
    <!--  全局字体色-提示  -->
    <SolidColorBrush x:Key="FontColor_Tips" Color="#D1CECE"/>
    <!--  全局字体色-按钮  -->
    <SolidColorBrush x:Key="FontColor_Btn" Color="#FFFFFF"/>

    <!--  表格行背景色-选中  -->
    <SolidColorBrush x:Key="BgColor_DataGridRowSelected" Opacity="0.1" Color="#A6A6A6"/>
    <!--  表格行字体色-选中  -->
    <SolidColorBrush x:Key="FontColor_DataGridRowSelected" Color="#273139"/>


    <!--  警告操作提示色  -->
    <SolidColorBrush x:Key="WraningColor" Color="Orange"/>
    <!--  危险操作提示色  -->
    <SolidColorBrush x:Key="DangerColor" Color="#DF4C5B"/>
</ResourceDictionary>